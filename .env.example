# Configuration d'EpiCoin pour `docker compose`.
#
# Copiez ce fichier en `.env` et adaptez-le AVANT le premier démarrage. Sans fichier `.env`,
# `docker compose up` lance une démonstration locale (http://localhost:8088, données de démo).
# Les valeurs ci-dessous sont celles d'une installation réelle.

# --- Site ------------------------------------------------------------------------------

# Adresse publique du site, utilisée dans les liens envoyés par email. HTTPS obligatoire
# en production : le cookie de session est alors marqué `Secure`.
EPICOIN_PUBLIC_URL=https://epicoin.example.org
EPICOIN_COOKIE_SECURE=true

# Où le conteneur web écoute sur la machine hôte. 127.0.0.1 si le reverse proxy HTTPS
# tourne sur la même machine ; 0.0.0.0 s'il est ailleurs.
EPICOIN_WEB_BIND=127.0.0.1
EPICOIN_WEB_PORT=8088

# Adresse (CIDR) du reverse proxy placé devant, pour retrouver l'adresse réelle des
# utilisateurs (limitation des tentatives de connexion).
EPICOIN_TRUSTED_PROXIES=172.16.0.0/12

# Seules les adresses de ce domaine peuvent avoir un compte.
EPICOIN_ALLOWED_EMAIL_DOMAIN=epitech.eu

# --- Données de démonstration -----------------------------------------------------------

# true : au premier démarrage, crée 150 étudiants fictifs, 5 encadrants et 10 produits, tous
# avec le mot de passe public « epicoin-demo ». JAMAIS en production.
EPICOIN_DEMO_SEED=false

# --- Emails -----------------------------------------------------------------------------

# `smtp` (production) ou `console` (les emails sont écrits dans les logs de l'API).
EPICOIN_MAILER=smtp
# smtps://… pour TLS direct (port 465), smtp://…?tls=required pour STARTTLS (port 587).
# Encodez les caractères spéciaux du mot de passe (%40 pour @…).
EPICOIN_SMTP_URL=smtps://utilisateur:mot-de-passe@smtp.example.org:465
EPICOIN_MAIL_FROM=EpiCoin <noreply@epitech.eu>

# --- Chaîne -----------------------------------------------------------------------------

# Identifiant de la chaîne, fixé au premier démarrage (lettres minuscules, chiffres, tirets).
EPICOIN_CHAIN_ID=epicoin-campus
# Quota de distribution par défaut d'un encadrant, en EPC par période de 30 jours.
EPICOIN_DEFAULT_MINT_QUOTA_EPC=500
# Intervalle de production des blocs quand des transactions attendent, en millisecondes.
EPICOIN_BLOCK_INTERVAL_MS=3000

# --- Base de données --------------------------------------------------------------------

# Pris en compte au tout premier démarrage seulement (création du volume Postgres).
EPICOIN_POSTGRES_USER=epicoin
EPICOIN_POSTGRES_PASSWORD=remplacez-moi-par-un-mot-de-passe-long
EPICOIN_POSTGRES_DB=epicoin
# Postgres n'est joignable que depuis la machine hôte, sur ce port.
EPICOIN_POSTGRES_PORT=5433

# --- Clés -------------------------------------------------------------------------------
#
# Par défaut, le premier démarrage génère toutes les clés et les range dans des volumes
# Docker séparés (le nœud ne voit que la sienne). Laissez ces variables vides, sauf pour
# fournir vos propres clés : une variable définie ici l'emporte sur le volume.
# Voir docs/guide-admin.md avant d'y toucher.
EPICOIN_VALIDATOR_KEY=
EPICOIN_ADMIN_KEY=
EPICOIN_TREASURY_KEY=
EPICOIN_MASTER_KEY=
EPICOIN_MASTER_KEY_PREVIOUS=

# --- Exploitation -----------------------------------------------------------------------

# `json` (un objet JSON par ligne, pour un collecteur de logs) ou `pretty`.
EPICOIN_LOG_FORMAT=json
RUST_LOG=info
# Dossier des sauvegardes de scripts/backup.sh.
EPICOIN_BACKUP_DIR=./backups
# Interface de la boîte mail de démonstration (Mailpit), sur la machine hôte uniquement.
EPICOIN_MAILPIT_PORT=8025
