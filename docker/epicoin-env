#!/bin/sh
# Loads the service's secrets (written once by epicoin-init) into the environment, then
# runs the command. A variable that is already set — from .env, say — takes precedence, so
# keys can also be provided from outside.
set -eu

file="${EPICOIN_SECRETS_FILE:-}"
if [ -n "$file" ] && [ -f "$file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | '#'*) continue ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    if [ -z "$(printenv "$key" 2>/dev/null || true)" ]; then
      export "$key=$value"
    fi
  done <"$file"
fi
exec "$@"
